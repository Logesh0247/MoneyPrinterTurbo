# The official runtime contains Python, FFmpeg and MoneyPrinter dependencies.
# Overlay this checkout so the deployment uses this branch's code.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx apache2-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /MoneyPrinterTurbo
COPY . .
EXPOSE 10000
CMD ["python3", "scripts/render_start.py"]
